# Base HTTP publique utilisée par le client React.
VITE_HIMMO_API_BASE_URL=/api

# Destination locale du proxy Vite vers Symfony.
HIMMO_API_URL=http://127.0.0.1:8000

# Clé publique Cloudflare Turnstile (sitekey), intégrée au bundle navigateur.
VITE_TURNSTILE_SITE_KEY=

# Production : URL de l’API incluant /api et domaine canonique du site.
PUBLIC_API_BASE_URL=
PUBLIC_SITE_URL=
