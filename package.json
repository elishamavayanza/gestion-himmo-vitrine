{
  "name": "h-immo-vitrine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "type-check": "tsc -b --pretty",
    "test:public-listings": "node --experimental-strip-types --test tests/verify-public-listing-price.mjs tests/verify-inquiry-contract.mjs tests/verify-public-api-schema.mjs tests/verify-public-api-client.mjs tests/verify-catalogue-query.mjs tests/verify-catalogue-grouping.mjs tests/verify-sitemap.mjs tests/verify-rendered-pages.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "start": "node scripts/server.mjs",
    "test:rendered-pages": "node --experimental-strip-types --test tests/verify-rendered-pages.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
